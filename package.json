{
  "name": "vostok-28",
  "private": true,
  "workspaces": [
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "preflight": "bash ./scripts/preflight.sh",
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web",
    "compose:up": "docker compose --profile infra --profile app up --build",
    "compose:infra": "docker compose --profile infra up -d",
    "compose:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "build": "npm run build -ws",
    "test": "npm run test -ws"
  }
}
